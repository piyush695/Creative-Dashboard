# ─────────────────────────────────────────────────────────────────────────────
# Hola Prime Creative Analyzer — environment variables
# Copy to .env and fill in. Grouped by necessity; dead/legacy vars are pruned.
# ─────────────────────────────────────────────────────────────────────────────

# ══ REQUIRED — the app (or a core feature) breaks without these ══════════════

# MongoDB connection string (users, creative_data, ad_library, brand knowledge)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# Claude API — powers ALL generation, scoring, enhancement, the director & analyzer
ANTHROPIC_API_KEY=sk-ant-...
# gpt-image-1 — the Studio's fast/direct image lane errors without it
OPENAI_API_KEY=sk-...
# Google OAuth sign-in (used with the @holaprime.com domain gate)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=...
# Session signing secret — generate fresh per environment, never reuse/commit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=CHANGE_ME
NEXTAUTH_SECRET=CHANGE_ME   # same value as AUTH_SECRET
# The DEPLOYED origin — also used to build email verification/reset links.
# Local dev: http://localhost:3000/api/auth and http://localhost:3000
AUTH_URL=https://your-domain.example/api/auth
NEXTAUTH_URL=https://your-domain.example
# Required when running behind a reverse proxy / cloud LB (Vercel, Cloud Run…)
AUTH_TRUST_HOST=true

# ══ FEATURE-GATED — feature is silently disabled without these ═══════════════

# Cloudinary — stores generated creatives as short CDN URLs instead of ~2MB
# data-URIs in Mongo. Strongly recommended in production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Meta Graph API — Meta dashboards sync + Ad Library ingestion
META_ACCESS_TOKEN=
# Ad accounts the Meta integrations read, format: id:Name,id2:Name2
AD_ACCOUNTS=
# Gemini — image model for the pattern-based / standard generation lanes
GEMINI_API_KEY=
# Verification + password-reset emails (Gmail app password). Without these,
# emails are skipped (dev prints the OTP to the server console).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Google Ads dashboards (all 5 needed to enable)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CLIENT_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# AdRoll dashboards
ADROLL_ACCESS_TOKEN=
ADROLL_ADVERTISABLE_EID=
# Ideogram — optional extra image provider in the fallback chain
IDEOGRAM_API_KEY=

# ══ OPTIONAL TUNING — safe defaults in code; set only to override ═════════════

# MONGODB_DB=reddit_data              # database name (alias: MONGODB_DB_NAME)
# MONGODB_COLLECTION=creative_data    # ads collection
# META_API_VERSION=v24.0              # Meta Graph API version
# TEXT_OVERLAY=off                    # 'off' = image model renders text inline (default: code overlay, zero-typo)
# STUDIO_CLEAN_TEXT_DEFAULT=off       # 'off' = integrated text by default (default: clean-text ON)
# STUDIO_BEST_OF=3                    # enhancer candidates per generation (1 = fast single brief)
# STUDIO_DIRECTOR_MODEL=claude-sonnet-4-6      # design-engine director model
# STUDIO_ENHANCER_MODEL=claude-opus-4-8        # prompt-enhancer model
# STUDIO_ENHANCER_TEMPERATURE=0.9
# STUDIO_ENHANCER_MAX_TOKENS=3000
# ACTIVE_OFFERS_PATH=                 # override path to active-offers.json (compliance gate)
# ANTHROPIC_MODEL=                    # realtime-analyzer model override
# ANTHROPIC_MAX_TOKENS=16384          # realtime-analyzer output cap
# ADROLL_API_BASE=https://api.adroll.com
